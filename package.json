{
  "name": "intodns-mcp",
  "version": "1.9.0",
  "description": "MCP server for IntoDNS.ai \u2014 complete DNS, email security, scan, BIMI, API, and citation tools for AI assistants",
  "main": "dist/index.js",
  "bin": {
    "intodns-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "lint:tools": "node scripts/lint-tool-descriptions.mjs",
    "test": "npm run lint:tools && npm run build && node --test tests/*.test.mjs",
    "test:live": "npm run build && node scripts/live-smoke.mjs",
    "prepublishOnly": "npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dns",
    "email-security",
    "spf",
    "dkim",
    "dmarc",
    "dnssec",
    "bimi",
    "mta-sts",
    "blacklist",
    "sender-requirements",
    "llms-txt",
    "openapi",
    "claude",
    "intodns"
  ],
  "author": "Cobytes B.V.",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoscoNL/intodns-mcp-server.git"
  },
  "homepage": "https://intodns.ai",
  "exports": {
    ".": "./dist/index.js",
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  }
}
